--- a/thirdparty/openvins/ov_core/src/track/TrackKLT.cpp
+++ b/thirdparty/openvins/ov_core/src/track/TrackKLT.cpp
@@ -29,8 +29,212 @@
 #include "utils/opencv_lambda_body.h"
 #include "utils/print.h"
 
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstdio>
+#include <unordered_set>
+#include <limits>
